{
  "functions": {
    "api/app-page.js": { "includeFiles": "dist/index.html" }
  },
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "agentslock.com" }],
      "destination": "https://www.agentslock.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/app/:id", "destination": "/api/app-page?id=:id" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    {
      "source": "/((?!.*\\.(?:png|jpg|jpeg|gif|svg|webp|ico|txt|xml|json|map|css|js|woff|woff2)$).*)",
      "destination": "/index.html"
    }
  ]
}
